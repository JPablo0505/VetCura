PORT=3001
DATABASE_PATH=./data/vetcura.db
UPLOAD_DIR=./data/uploads
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT_MAX=30
TAX_RATE=0.19
# Google Sign-In (all empty = endpoint answers 501, never fakes a session)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_AUDIENCES=
# Email provider (SMTP). All empty = notifications stay pending, never fake-sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# FCM HTTP v1 push. All empty = push refuses honestly.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_EMAIL=
FCM_SERVICE_ACCOUNT_KEY=
CORS_ORIGIN=
